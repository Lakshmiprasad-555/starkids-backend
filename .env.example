# ============================================================
#  STAR KIDS CONNECT — Copy this to .env and fill values
#  Run: cp .env.example .env
#  NEVER push .env to GitHub!
# ============================================================

PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/starkids?retryWrites=true&w=majority
MONGO_POOL_SIZE=10

JWT_SECRET=starkids_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=starkidsschool@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

SCHOOL_NAME=Star Kids English Medium School
SCHOOL_TAGLINE=Where Every Child Shines
SCHOOL_EMAIL=starkids@gmail.com
SCHOOL_PHONE=+91XXXXXXXXXX
SCHOOL_ADDRESS=Your School Address Here

PRINCIPAL_NAME=Principal Name
PRINCIPAL_EMAIL=principal@starkids.com
PRINCIPAL_PASSWORD=Admin@123
PRINCIPAL_PHONE=+91XXXXXXXXXX
